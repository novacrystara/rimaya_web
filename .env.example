# Copy to .env.local for development. In production set the same names in
# Vercel → Project → Settings → Environment Variables. Never commit .env.local.

# ── Email delivery (Resend) ─────────────────────────────────────────────
# Without RESEND_API_KEY, form submissions are logged to the server console
# instead of emailed — fine in dev, invisible in production (CLAUDE.md §7).
RESEND_API_KEY=
RIMAYA_INBOX=
RIMAYA_FROM=
